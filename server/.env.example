# Copy to .env and fill every value before running the API.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL connection. Supabase direct or pooler URLs both work.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Use auto for local false / remote true, or force true/false.
DATABASE_SSL=auto
DATABASE_POOL_MAX=5

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200

# Auth0 API settings. AUTH0_AUDIENCE must match the API identifier used by the SPA.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://task-dashboard-api

# Required for uploading profile avatars to Vercel Blob.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_DdXns9nHX6wUvtjk_YnCzha3alxX6dzFxc2e17vMb1L55ul
