# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# Compiled output (relative to client/)
/dist
/tmp
/out-tsc
/bazel-out

# Environment
.env
.env.local

# Node
/node_modules
npm-debug.log
yarn-error.log

# Angular
.angular/cache

# Testing
/coverage
/libpeerconnection.log
testem.log
/typings

# IDE (client-local overrides; repo root .gitignore also applies)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# System
.DS_Store
Thumbs.db
