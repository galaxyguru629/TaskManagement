# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Used at build/serve time by scripts/generate-environment.mjs
# (Angular bundles these into the app — they are NOT read at runtime in the browser.)

# --- GraphQL API (required) ---
GRAPHQL_HTTP_URI=http://localhost:4000/graphql
GRAPHQL_WS_URI=ws://localhost:4000/graphql

# From another device on your LAN, use your PC's IP instead of localhost:
# GRAPHQL_HTTP_URI=http://192.168.1.10:4000/graphql
# GRAPHQL_WS_URI=ws://192.168.1.10:4000/graphql

# Production example (uncomment and set when deploying):
# GRAPHQL_HTTP_URI=https://your-api.onrender.com/graphql
# GRAPHQL_WS_URI=wss://your-api.onrender.com/graphql

# --- Auth0 (required) ---
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_spa_client_id
AUTH0_AUDIENCE=https://task-dashboard-api

# Sign-out uses local logout by default (no Allowed Logout URLs required).
# Optional: for full Auth0 SSO logout, add these under Allowed Logout URLs:
#   http://localhost:4200/login
#   https://your-production-domain/login

# Auth0 is required locally and in production because the backend validates real JWTs.
DEV_AUTH_BYPASS=false

# Vercel / CI may use NG_APP_* prefixed names instead (both are supported):
# NG_APP_GRAPHQL_HTTP_URI=
# NG_APP_GRAPHQL_WS_URI=
# NG_APP_AUTH0_DOMAIN=
# NG_APP_AUTH0_CLIENT_ID=
# NG_APP_AUTH0_AUDIENCE=
# NG_APP_DEV_AUTH_BYPASS=false
